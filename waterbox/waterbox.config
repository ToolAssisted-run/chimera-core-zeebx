{
 "coreName": "Zeebx",
 "systemId": "ZEEBO",
 "systemNames": {
  "ZEEBO": "Zeebo"
 },
 "author": "The Zeebx team; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-zeebx",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  2048,
  16,
  16,
  64,
  4096
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The heap holds the emulator's own memory and the console's files, which are kept in memory: the unpacked game (the largest tested is 74 MiB) and what it saves. The recompiler's code is mapped. Only what is touched costs anything.",
 "video": {
  "_comment": "The console's picture: 640x480, drawn by Zeebx's own software renderer inside the core, so it is the same on every computer. 60 frames a second counted on the game's own clock.",
  "width": 640,
  "height": 480,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1
 },
 "audio": {
  "_comment": "Zeebx's mix of everything the game plays: 44.1 kHz stereo, exactly 735 pairs a frame.",
  "rate": 44100,
  "samplesPerFrame": 735,
  "channels": 2,
  "get": "GetAudio"
 },
 "extensions": {
  ".mod": "ZEEBO"
 },
 "input": {
  "name": "Zeebo Controllers",
  "_comment": "Two controllers. Each has a D-pad, the four face buttons numbered as they are printed on the controller, the two triggers ZL and ZR, Start, Back, and two sticks that can be pressed. The sticks run -128..127 with 0 at rest; right and down are positive, as on the console. How many controllers are plugged in is the Controllers setting; one that is not plugged in has no columns in a movie.",
  "buttons": [
   "P1 Up",
   "P1 Down",
   "P1 Left",
   "P1 Right",
   "P1 1",
   "P1 2",
   "P1 3",
   "P1 4",
   "P1 ZL",
   "P1 ZR",
   "P1 Start",
   "P1 Back",
   "P1 Left Stick",
   "P1 Right Stick",
   "P2 Up",
   "P2 Down",
   "P2 Left",
   "P2 Right",
   "P2 1",
   "P2 2",
   "P2 3",
   "P2 4",
   "P2 ZL",
   "P2 ZR",
   "P2 Start",
   "P2 Back",
   "P2 Left Stick",
   "P2 Right Stick"
  ],
  "mnemonics": {
   "Up": "U",
   "Down": "D",
   "Left": "L",
   "Right": "R",
   "1": "1",
   "2": "2",
   "3": "3",
   "4": "4",
   "ZL": "l",
   "ZR": "r",
   "Start": "S",
   "Back": "s",
   "Left Stick": "<",
   "Right Stick": ">"
  },
  "axes": [
   {
    "name": "P1 Left Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "LX"
   },
   {
    "name": "P1 Left Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "LY"
   },
   {
    "name": "P1 Right Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "RX"
   },
   {
    "name": "P1 Right Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "RY"
   },
   {
    "name": "P2 Left Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "LX"
   },
   {
    "name": "P2 Left Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "LY"
   },
   {
    "name": "P2 Right Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "RX"
   },
   {
    "name": "P2 Right Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "RY"
   }
  ]
 },
 "settings": [
  {
   "name": "pads",
   "display": "setting.pads",
   "type": "enum",
   "options": [
    "1",
    "2"
   ],
   "default": "1",
   "description": "setting.pads.about"
  },
  {
   "name": "rtc_start",
   "display": "setting.rtc_start",
   "type": "int",
   "default": 1262304000,
   "min": 315964800,
   "max": 2145916800,
   "description": "setting.rtc_start.about"
  }
 ]
}
